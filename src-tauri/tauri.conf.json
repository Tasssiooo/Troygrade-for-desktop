{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Troygrade",
  "version": "0.0.4",
  "identifier": "tasssiooo.troygrade.leischii",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "troygrade",
        "decorations": false,
        "fullscreen": false,
        "resizable": false,
        "center": true,
        "minWidth": 1024,
        "width": 1024,
        "maxWidth": 1024,
        "minHeight": 576,
        "height": 576,
        "maxHeight": 576
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQkMzRTlEQTE4NkI0NTQKUldSVXRJYWhuVDY4eXRsOXl4QlBLN3ZpTVNKN2JwRmgzYkZ0ZjN4VzZqZks1V1QrVVVFZFFzVWgK",
      "endpoints": [
        "https://gist.githubusercontent.com/Tasssiooo/48f6c4af1a2d4add2e7b176a4e3e6634/raw"
      ]
    }
  }
}
